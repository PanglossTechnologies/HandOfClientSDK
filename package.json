{
  "name": "handofclient-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "HandOfClient SDK: proto contract, generated clients, embed.js, publisher CLI, host adapters and samples.",
  "license": "Apache-2.0",
  "workspaces": [
    "gen/ts",
    "clients/ts",
    "sdk/embed-js",
    "tools/publisher-cli",
    "samples/plugins/hello-world",
    "samples/plugins/vendor-spend-dashboard",
    "samples/plugins/wp-site-snapshot"
  ],
  "scripts": {
    "build": "npm run build -w @handofclient/gen-ts -w @handofclient/api -w @handofclient/embed-js -w @handofclient/publisher-cli -w @handofclient/sample-hello-world-plugin -w @handofclient/vendor-spend-dashboard-plugin -w @handofclient/wp-site-snapshot-plugin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint:public": "node tools/lint-public-repo.mjs",
    "test:conformance": "node host-modules/conformance/selftest/selftest.mjs",
    "proto:lint": "buf lint proto",
    "proto:generate": "buf generate",
    "test:conformance-mutants": "node host-modules/conformance/selftest/mutants.mjs",
    "lint:openapi": "redocly lint openapi/site-hoc-api.yaml openapi/platform-host-v1.yaml",
    "check:generated": "npm run proto:generate && git diff --exit-code -- gen",
    "publish:dry-run:samples": "npm run publish:dry-run --workspaces --if-present",
    "smoke:dotnet-sample": "node tools/ci/smoke-dotnet-sample.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@redocly/cli": "^2.62.0"
  }
}
