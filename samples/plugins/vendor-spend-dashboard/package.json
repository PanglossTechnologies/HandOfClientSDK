{
  "name": "@handofclient/vendor-spend-dashboard-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Task E4 dogfood plugin: real vendor-spend bar chart shipped to warehouse (GT Bakery) via HandOfClient instead of DotNetShared.Extensibility.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publish:dry-run": "hoc-publish --manifest manifest.json --bundle bundle-dist --api-key unused-for-dry-run --dry-run",
    "publish": "hoc-publish --manifest manifest.json --bundle bundle-dist"
  },
  "dependencies": {
    "@handofclient/embed-js": "*"
  },
  "devDependencies": {
    "@handofclient/publisher-cli": "*",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
