{
  "openapi": "3.0.3",
  "info": { "title": "Acme orders", "version": "1.0.0" },
  "paths": {
    "/api/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "Orders visible to the caller",
        "responses": {
          "200": {
            "description": "The orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "owner": { "type": "string" },
                      "customer": { "type": "string" },
                      "total": { "type": "number" },
                      "status": { "type": "string", "enum": ["open", "shipped"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
