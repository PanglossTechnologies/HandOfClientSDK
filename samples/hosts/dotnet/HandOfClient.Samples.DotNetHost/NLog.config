<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${basedir}/logs/nlog-internal.log">
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <variable name="messageLayout" value="${level:format=FirstCharacter}:${longdate}|${callsite}|${message}${onexception:${newline}${exception:format=Message,StackTrace,Data:maxInnerExceptionLevel=10}}"/>
  <variable name="logdir" value="${environment:NLOG_LOGDIR:whenEmpty=${basedir}/logs}/${environment:ASPNETCORE_ENVIRONMENT:whenEmpty=Unknown}"/>

  <targets>
    <target name="file" xsi:type="File" fileName="${logdir}/${processname}${var:cmdlinearg}.txt"
            archiveFileName="${logdir}/archive/${processname}${var:cmdlinearg}/${processname}${var:cmdlinearg}_{#}.txt" archiveOldFileOnStartup="true"
      keepFileOpen="true" archiveNumbering="DateAndSequence" archiveEvery="Day" maxArchiveFiles="1000" layout="${messageLayout}" archiveDateFormat="yyyyMMdd" />
    <target name="fileerror" xsi:type="File" fileName="${logdir}/error${processname}${var:cmdlinearg}.txt"
            archiveFileName="${logdir}/archive/${processname}${var:cmdlinearg}/error${processname}${var:cmdlinearg}_{#}.txt"
      keepFileOpen="true" archiveNumbering="DateAndSequence" archiveEvery="Day" maxArchiveFiles="1000" layout="${messageLayout}" archiveDateFormat="yyyyMMdd" />
    <target xsi:type="ColoredConsole" name="console" layout="${messageLayout}" />
    <target xsi:type="Debugger" name="debug" layout="${messageLayout}" />
  </targets>

  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Warning" final="true" />

    <logger name="*" minlevel="Error" writeTo="fileerror,file,console,debug" final="true" />
    <logger name="*" minlevel="Info" maxlevel="Warn" writeTo="file,console,debug" final="true" />
  </rules>
</nlog>
