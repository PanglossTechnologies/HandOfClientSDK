{
  "name": "handofclient/host",
  "description": "HandOfClient host module for PHP: request, build and roll out per-user site features (plain PHP, Laravel; SQLite, PostgreSQL, MySQL).",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": ["handofclient", "laravel", "plugins", "customization"],
  "homepage": "https://github.com/PanglossTechnologies/HandOfClientSDK/tree/main/host-modules/php",
  "support": {
    "source": "https://github.com/PanglossTechnologies/HandOfClientSDK/tree/main/host-modules/php",
    "issues": "https://github.com/PanglossTechnologies/HandOfClientSDK/issues"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "suggest": {
    "ext-pdo": "Needed by SqlStorage (with pdo_sqlite, pdo_pgsql or pdo_mysql)",
    "ext-curl": "Used by PlatformClient when present; otherwise it falls back to PHP streams (allow_url_fopen)",
    "laravel/framework": "For the Laravel adapter (HandOfClient\\Host\\Adapter\\Laravel)"
  },
  "autoload": {
    "psr-4": {
      "HandOfClient\\Host\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HandOfClient\\Host\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
