# WordPress plugin build output. embed.global.js is copied in from sdk/embed-js at build time
# (host-adapters/wordpress/build.mjs), so it is generated, not source.
host-adapters/wordpress/dist/
host-adapters/wordpress/handofclient/assets/js/embed.global.js

# Local WordPress dev harness: a downloaded portable PHP, a WordPress install and its SQLite
# database. Entirely reproducible from host-adapters/wordpress/devharness/setup.mjs, so none of it is
# source. Also contains a live host API key in wp-config/options - never commit it.
.wp-local/

# PHP host module (host-modules/php): composer deps, PHPUnit cache, and the local PHP/composer toolchain + Laravel conformance app (dev box only)
vendor/
.phpunit.cache/
composer.lock
.php-local/
.laravel-conformance/

# Python Flask sample: assets copied in by fetch_assets.py, and its local database
samples/hosts/python-flask/static/embed.global.js
samples/hosts/python-flask/static/hoc-head.min.js
samples/hosts/python-flask/hoc.db*
